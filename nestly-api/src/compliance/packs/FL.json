    { "title": "Florida DCF Background Screening FAQ — Child Care Licensing", "url": "https://www.myflfamilies.com/services/background-screening/frequently-asked-questions-specific-child-care-licensing" },
    { "title": "Florida Childcare Ratios — CentreCareOS", "url": "https://www.centrecareos.com/resources/ratios/florida" },
    { "title": "Florida Staff-to-Child Ratio Requirements — ChildcareComp", "url": "https://childcarecomp.com/articles/licensing-requirements/florida-staff-child-ratio-requirements" },
    { "title": "Florida Childcare Licensing Requirements — Brightwheel", "url": "https://mybrightwheel.com/licensing-requirements/florida/" }
  ]
}
