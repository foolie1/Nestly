# Copy to .env for local development
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgres://nestly:nestly@localhost:5432/nestly

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h

# Seed data password for every demo user (dev only)
SEED_PASSWORD=nestly-dev
